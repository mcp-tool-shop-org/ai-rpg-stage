[gd_scene load_steps=2 format=3 uid="uid://ai_rpg_stage_diorama"]

[ext_resource type="Script" path="res://stage/diorama.gd" id="diorama_script"]

; The diorama is a single scripted root, on purpose.
;
; Everything below it — the exported world, the light rig, the dressing sets, the cast,
; the camera — is built in `diorama.gd`. The alternative is authoring those nodes here
; and looking them up by name at runtime, which is how a renamed node becomes a silent
; null and a rig that quietly does nothing. A scene file that cannot drift from its
; script is worth more than one that shows its structure in the editor.
;
; `fixtures/world.tscn` is INSTANCED rather than inherited, because it is regenerated by
; world-forge on every content change and an inherited scene would carry local edits
; that the next export silently discards.

[node name="Diorama" type="Node2D"]
script = ExtResource("diorama_script")
