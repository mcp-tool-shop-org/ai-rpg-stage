[node name="The_Weighing_Floor" type="Node2D" parent="."]
position = Vector2(1440, 576)
y_sort_enabled = true
z_index = 0
metadata/zone_id = "weighing-floor"
metadata/description = "Six brass scales and only the third one is trusted. Corvane presses his thumb into a bead of wax on its beam at close of day, so anyone who re-tares it overnight has to explain a broken thumbprint in the morning. The queue forms before the doors open. Everyone in it is carrying salt and a grievance about salt."
metadata/light = 5
metadata/noise = 6
metadata/elevation = 0
metadata/district_id = "saltgate"

