[node name="The_Long_Quay" type="Node2D" parent="."]
position = Vector2(1440, 1872)
y_sort_enabled = true
z_index = 0
metadata/zone_id = "long-quay"
metadata/description = "Long enough that the far end keeps its own weather. Hawsers coiled chest-high, a crane that screams on the upstroke, and a tally-boy who has learned to deliver bad news from just outside arm's reach. Where the tide gets over the lip the stone stays wet, and it does not look wet."
metadata/light = 7
metadata/noise = 8
metadata/elevation = 0
metadata/district_id = "dockward"

