[node name="The_Bonded_Warehouse" type="Node2D" parent="."]
position = Vector2(2880, 432)
y_sort_enabled = true
z_index = 0
metadata/zone_id = "bonded-warehouse-DOCTORED"
metadata/description = "Everything in here belongs to somebody who is not here. Crates under seal stacked to the beams, and at the back a cage for goods nobody came for — the cage has a heavy lock and the door is left standing open, which tells you exactly what the Guild thinks of anyone who would try it. The air is dry enough to hurt your throat. Salt only keeps if it stays that way."
metadata/light = 2
metadata/noise = 2
metadata/elevation = 0
metadata/district_id = "saltgate"
metadata/entry_gate = "item:guild-seal"
metadata/entry_gate_mode = "hard"
metadata/entry_gate_reason = "Halle keeps her hand flat on the register. \"It's my name beside whatever leaves here, and I've a mother in Dockward. Seal, or nothing.\""

