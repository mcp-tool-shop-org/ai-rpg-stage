[node name="The_Counting_House" type="Node2D" parent="."]
position = Vector2(288, 576)
y_sort_enabled = true
z_index = 0
metadata/zone_id = "counting-house"
metadata/description = "Your standing desk, your ledger, and a wax jack burned down to a stub because you keep meaning to trim it and keep not doing it. The window faces the water, which was the entire reason for the rent. On a bad morning you can stand here and watch your own cargo fail to arrive."
metadata/light = 4
metadata/noise = 1
metadata/elevation = 0
metadata/district_id = "saltgate"

